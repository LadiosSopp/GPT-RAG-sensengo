<mxCell id="30h" value="&lt;b&gt;Step 3: GPT-5 Script Generation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;~30-60s | GPT-5.2&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontFamily=Segoe UI;fontColor=#FFFFFF;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1">
