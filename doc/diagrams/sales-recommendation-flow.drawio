<mxCell id="20h" value="&lt;b&gt;Step 2: Dynamic RAG Query&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;~1-3s | GPT-5-mini + AI Search&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontFamily=Segoe UI;fontColor=#FFFFFF;fillColor=#FF8C00;strokeColor=none;" vertex="1" parent="1">
<mxGeometry x="530" y="80" width="310" height="45" as="geometry"/>
</mxCell>
<mxCell id="21" value="&lt;div style=&quot;text-align:left;padding:8px&quot;&gt;&lt;b style=&quot;color:#FF8C00&quot;&gt;LLM Query Generation&lt;/b&gt;&lt;br&gt;&lt;br&gt;GPT-5-mini analyzes persona to&lt;br&gt;generate search query&lt;br&gt;&lt;br&gt;&lt;b&gt;5 Analysis Dimensions:&lt;/b&gt;&lt;br&gt;1. Spending → Card tier&lt;br&gt;2. Interests → Benefit match&lt;br&gt;3. Family → Shared needs&lt;br&gt;4. Pain points → Targeted search&lt;br&gt;5. Past rejections → Avoidance&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF8C00;strokeWidth=1.5;fontSize=12;fontFamily=Segoe UI;fontColor=#323130;arcSize=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="1">
<mxGeometry x="535" y="145" width="300" height="280" as="geometry"/>
</mxCell>
<mxCell id="22" value="&lt;div style=&quot;text-align:left;padding:8px&quot;&gt;&lt;b style=&quot;color:#FF8C00&quot;&gt;search_membership_card&lt;/b&gt;&lt;br&gt;&lt;br&gt;Azure AI Search&lt;br&gt;&lt;b&gt;Hybrid Retrieval&lt;/b&gt;&lt;br&gt;(Keyword + Vector Semantic)&lt;br&gt;&lt;br&gt;→ Top-5 membership docs&lt;br&gt;→ Pricing, benefits, advantages&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF8C00;strokeWidth=1.5;fontSize=12;fontFamily=Segoe UI;fontColor=#323130;arcSize=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="1">
