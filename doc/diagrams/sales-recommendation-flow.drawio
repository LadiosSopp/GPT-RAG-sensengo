<mxCell id="10h" value="&lt;b&gt;Step 1: Fetch Data&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;~1-2s | MCP Tools&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontFamily=Segoe UI;fontColor=#FFFFFF;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1">
<mxGeometry x="210" y="80" width="260" height="45" as="geometry"/>
</mxCell>
<mxCell id="11" value="&lt;div style=&quot;text-align:left;padding:8px&quot;&gt;&lt;b style=&quot;color:#0078D4&quot;&gt;query_customer_persona&lt;/b&gt;&lt;br&gt;&lt;br&gt;Azure SQL DB&lt;br&gt;&lt;b&gt;53-field Customer Persona&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Spending power level&lt;br&gt;• Interests &amp;amp; preferences&lt;br&gt;• Family status&lt;br&gt;• Lifestyle tags&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontFamily=Segoe UI;fontColor=#323130;arcSize=8;verticalAlign=top;spacingTop=2;" vertex="1" parent="1">
