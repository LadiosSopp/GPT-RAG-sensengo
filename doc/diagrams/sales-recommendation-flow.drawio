<mxCell id="33" value="&lt;div style=&quot;text-align:left;padding:5px&quot;&gt;&lt;b style=&quot;color:#107C10;font-size:13px&quot;&gt;7-Part Sales Script&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Opening&lt;br&gt;2. Needs Discovery&lt;br&gt;3. Product Pitch&lt;br&gt;4. Benefit Highlight&lt;br&gt;5. Objection Handling&lt;br&gt;6. Closing&lt;br&gt;7. Follow-up Strategy&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;fontFamily=Segoe UI;fontColor=#323130;arcSize=8;verticalAlign=top;" vertex="1" parent="1">
