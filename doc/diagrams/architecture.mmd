    classDef ingestStyle fill:#107C10,stroke:#0B5A0B,color:#fff,stroke-width:2px
    classDef azureStyle fill:#0078D4,stroke:#005A9E,color:#fff,stroke-width:2px

    class CHAINLIT,FASTAPI_UI uiStyle
    class FASTAPI_ORCH,RAG_AGENT,SALES_REC orchStyle
